# Copy this to config.env and fill in your values.
#   cp config.env.example config.env

# Your GitHub username/org and the repo name that holds this project.
GITHUB_OWNER=your-github-username
GITHUB_REPO=moetikeenjasaan

# A GitHub Personal Access Token (classic) with scopes: repo, read:packages.
# Used for (a) the cluster's ghcr image-pull secret and (b) Argo CD repo access.
# Prefer exporting it in your shell instead of committing it here:
#   export GITHUB_PAT=ghp_xxx
GITHUB_PAT=
