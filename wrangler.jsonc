{
  // Name must match your Cloudflare Worker's name.
  "name": "cool-app",
  "compatibility_date": "2026-07-12",
  // Static-assets-only Worker: no server code, just serve ./dist.
  // The build command (mkdir -p dist && cp index.html dist/) fills this folder.
  "assets": {
    "directory": "./dist"
  }
}
